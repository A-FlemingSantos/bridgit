# Copie para .env na raiz. O .env nao e versionado.
# Quem le este arquivo: so os scripts bash em scripts/dev/ (variaveis ja definidas no processo tem prioridade).
# Nem o Maven, nem o Vite/Expo iniciados direto (npm run api, npm run dev...), nem os scripts PowerShell o leem;
# no Windows use scripts/powershell/local.secrets.ps1 (veja local.secrets.example.ps1).
VITE_DEV_HOST=localhost
VITE_API_PROXY_TARGET=http://localhost:8080
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=bridgit_db;encrypt=false;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
APP_JWT_SECRET=
APP_FRONTEND_BASE_URL=http://localhost:5173
APP_MOBILE_REDIRECT_PREFIXES=bridgit://
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_INTEGRATION_TOKEN_KEY_B64=
APP_ONEDRIVE_CLIENT_ID=
APP_ONEDRIVE_CLIENT_SECRET=
APP_ONEDRIVE_REDIRECT_URI=http://localhost:8080/api/providers/onedrive/callback
APP_GOOGLE_DRIVE_CLIENT_ID=
APP_GOOGLE_DRIVE_CLIENT_SECRET=
APP_GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8080/api/providers/google-drive/callback
APP_DROPBOX_CLIENT_ID=
APP_DROPBOX_CLIENT_SECRET=
APP_DROPBOX_REDIRECT_URI=http://localhost:8080/api/providers/dropbox/callback
# Mobile: deixe comentada em desenvolvimento. Esta variavel tem prioridade sobre o IP que o Expo anuncia, e no
# Android "localhost" e o proprio aparelho/emulador, entao o app nao alcanca a API. Use so em build de release
# ou quando a API nao esta no PC que roda o Metro (ex.: https://api.exemplo.com).
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
APP_HUB_CATALOG_ENABLED=true
APP_HUB_OPERATIONS_ENABLED=true
APP_HUB_WORKER_ENABLED=true
APP_HUB_CONTENT_CACHE_ENABLED=true
APP_HUB_DIRECT_READ_ENABLED=true
APP_HUB_WEBHOOK_BASE_URL=
APP_HUB_UPLOAD_DIRECTORY=./data/pending-uploads
