# Modelo de /etc/bridgit/api.env (lido pelo systemd via EnvironmentFile=).
# Instalar:  sudo install -o root -g bridgit -m 0640 api.env.example /etc/bridgit/api.env  e editar.
# Permissao final obrigatoria: 0640 root:bridgit (contem segredos; nunca versionar o arquivo preenchido).
# Formato systemd: CHAVE=valor, sem aspas e sem "export". Valores gerados abaixo sao alfanumericos/base64 e nao precisam de escape.
# Depois de editar:  sudo systemctl restart bridgit-api

# --- Banco (SQL Server local; criado por setup-sql.sh) -------------------------------------------
# O banco TEM que se chamar bridgit_db (a API valida isso na partida).
SPRING_DATASOURCE_URL=jdbc:sqlserver://127.0.0.1:1433;databaseName=bridgit_db;encrypt=true;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=bridgit_app
# Mesma senha informada ao setup-sql.sh (BRIDGIT_APP_PASSWORD).
SPRING_DATASOURCE_PASSWORD=

# --- Segredos da aplicacao ------------------------------------------------------------------------
# Minimo 32 bytes e NAO pode comecar com "dev-only-". Gerar: openssl rand -base64 48
APP_JWT_SECRET=
# Base64 de EXATAMENTE 32 bytes (AES-256). Gerar: openssl rand -base64 32
# Trocar essa chave invalida os tokens de provedores ja salvos no banco.
APP_INTEGRATION_TOKEN_KEY_B64=

# --- Front (web servido pelo Caddy na VM) ----------------------------------------------------------------
# Origem do web, sem barra final e sem caminho. Tambem e a base dos links publicos e do retorno do OAuth.
APP_FRONTEND_BASE_URL=https://app.bridgit-cloud.duckdns.org
# Lista separada por virgula de origens permitidas no CORS.
APP_CORS_ALLOWED_ORIGINS=https://app.bridgit-cloud.duckdns.org
# Prefixos para onde o fluxo OAuth pode devolver o app mobile.
APP_MOBILE_REDIRECT_PREFIXES=bridgit://

# --- Provedores OAuth (registre as redirect URIs abaixo em cada console; veja README) -------------
APP_ONEDRIVE_CLIENT_ID=
APP_ONEDRIVE_CLIENT_SECRET=
APP_ONEDRIVE_REDIRECT_URI=https://api.bridgit-cloud.duckdns.org/api/providers/onedrive/callback

APP_GOOGLE_DRIVE_CLIENT_ID=
APP_GOOGLE_DRIVE_CLIENT_SECRET=
APP_GOOGLE_DRIVE_REDIRECT_URI=https://api.bridgit-cloud.duckdns.org/api/providers/google-drive/callback

APP_DROPBOX_CLIENT_ID=
APP_DROPBOX_CLIENT_SECRET=
APP_DROPBOX_REDIRECT_URI=https://api.bridgit-cloud.duckdns.org/api/providers/dropbox/callback

# --- Hub -------------------------------------------------------------------------------------------
# URL publica base dos webhooks dos provedores (aponta para o Caddy).
APP_HUB_WEBHOOK_BASE_URL=https://api.bridgit-cloud.duckdns.org
# Diretorio de uploads pendentes: precisa estar em ReadWritePaths da unit e pertencer ao usuario bridgit.
APP_HUB_UPLOAD_DIRECTORY=/var/lib/bridgit/pending-uploads
# Opcionais (padroes ja sao true): APP_HUB_CATALOG_ENABLED, APP_HUB_OPERATIONS_ENABLED,
# APP_HUB_WORKER_ENABLED, APP_HUB_CONTENT_CACHE_ENABLED, APP_HUB_DIRECT_READ_ENABLED.
# Opcional: com alguem usando o app, intervalo minimo (s) entre syncs adiantados de cada conexao. Padrao 5;
# aumente se a VM ficar sobrecarregada.
# APP_HUB_NUDGE_SECONDS=5

# --- Servidor (atras do Caddy) ---------------------------------------------------------------------
# Respeita X-Forwarded-* enviados pelo Caddy.
SERVER_FORWARD_HEADERS_STRATEGY=native
# Escuta so em loopback; a porta 8080 nunca fica exposta.
SERVER_ADDRESS=127.0.0.1
